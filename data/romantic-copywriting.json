{
  "type": "騷話文案",
  "updated": "2026-08-19T03:27:22.387Z",
  "updateTime": "2026/8/19 上午11:27:22",
  "totalCount": 50,
  "targetCount": 50,
  "completionRate": "100.0%",
  "convertedToTraditional": true,
  "copywritings": [
    {
      "id": 1,
      "content": "我不會讓你哭的，除了在床上",
      "length": 13,
      "addedAt": "2026-08-19T03:27:22.387Z"
    },
    {
      "id": 2,
      "content": "做不了愛人，那做愛吧",
      "length": 10,
      "addedAt": "2026-08-19T03:27:22.387Z"
    },
    {
      "id": 3,
      "content": "曾經硬著等 現在等著硬 ",
      "length": 12,
      "addedAt": "2026-08-19T03:27:22.387Z"
    },
    {
      "id": 4,
      "content": "我要成為你的王 從此你就是王后 ",
      "length": 16,
      "addedAt": "2026-08-19T03:27:22.387Z"
    },
    {
      "id": 5,
      "content": "你今天特別討厭 討人喜歡 百看不厭 ",
      "length": 18,
      "addedAt": "2026-08-19T03:27:22.387Z"
    },
    {
      "id": 6,
      "content": "寶貝乖我輕點插",
      "length": 7,
      "addedAt": "2026-08-19T03:27:22.387Z"
    },
    {
      "id": 7,
      "content": "小妹妹～別走啊～哥哥給你看個寶貝～",
      "length": 17,
      "addedAt": "2026-08-19T03:27:22.387Z"
    },
    {
      "id": 8,
      "content": "我沒有野心 我只想睡你",
      "length": 11,
      "addedAt": "2026-08-19T03:27:22.387Z"
    },
    {
      "id": 9,
      "content": "翻雲覆雨 ",
      "length": 5,
      "addedAt": "2026-08-19T03:27:22.387Z"
    },
    {
      "id": 10,
      "content": "我想知道你此刻穿得內衣的顏色 ",
      "length": 15,
      "addedAt": "2026-08-19T03:27:22.387Z"
    },
    {
      "id": 11,
      "content": "我是預言家 今天我預測了你的身份 你是我喜歡的人",
      "length": 24,
      "addedAt": "2026-08-19T03:27:22.387Z"
    },
    {
      "id": 12,
      "content": "昨晚摸了你一下 舒不舒服 ",
      "length": 13,
      "addedAt": "2026-08-19T03:27:22.387Z"
    },
    {
      "id": 13,
      "content": "你主動點 我們不僅會有故事 還會有孩子 ",
      "length": 20,
      "addedAt": "2026-08-19T03:27:22.387Z"
    },
    {
      "id": 14,
      "content": "玫瑰是我偷的，情書是我抄的，但我想操你是真的。",
      "length": 23,
      "addedAt": "2026-08-19T03:27:22.387Z"
    },
    {
      "id": 15,
      "content": "我想和你 每天做四件事 一日三餐",
      "length": 16,
      "addedAt": "2026-08-19T03:27:22.387Z"
    },
    {
      "id": 16,
      "content": "獨坐空房手作妻，此事不與外人提 若是左手換右手，如同休妻再娶妻 一搓一搓復一搓，兩眼迷離骨酥釐 點點滴滴落在地，子子孫孫化作泥",
      "length": 63,
      "addedAt": "2026-08-19T03:27:22.387Z"
    },
    {
      "id": 17,
      "content": "來日方長，細水長流",
      "length": 9,
      "addedAt": "2026-08-19T03:27:22.387Z"
    },
    {
      "id": 18,
      "content": "將你摁在床上俯視著你，單手解開皮帶扣",
      "length": 18,
      "addedAt": "2026-08-19T03:27:22.387Z"
    },
    {
      "id": 19,
      "content": "我看你挺會走路的 走進我心裡好不好",
      "length": 17,
      "addedAt": "2026-08-19T03:27:22.387Z"
    },
    {
      "id": 20,
      "content": "老子不管 你考慮下 ",
      "length": 10,
      "addedAt": "2026-08-19T03:27:22.387Z"
    },
    {
      "id": 21,
      "content": "外面超多情侶 我害怕 我一出現 他們就後悔自己已經有女朋友了 ",
      "length": 31,
      "addedAt": "2026-08-19T03:27:22.387Z"
    },
    {
      "id": 22,
      "content": "雪花來了，我的心還空著，你來嗎？",
      "length": 16,
      "addedAt": "2026-08-19T03:27:22.387Z"
    },
    {
      "id": 23,
      "content": "承蒙你出現 夠我新鮮感好多年 ",
      "length": 15,
      "addedAt": "2026-08-19T03:27:22.387Z"
    },
    {
      "id": 24,
      "content": "常山趙子龍七進七出，主公里面請",
      "length": 15,
      "addedAt": "2026-08-19T03:27:22.387Z"
    },
    {
      "id": 25,
      "content": "晚安，來睡我吧 ",
      "length": 8,
      "addedAt": "2026-08-19T03:27:22.387Z"
    },
    {
      "id": 26,
      "content": "許久未見，就該把她狠狠地推到牆上吻到天荒地老！",
      "length": 23,
      "addedAt": "2026-08-19T03:27:22.387Z"
    },
    {
      "id": 27,
      "content": "你知道什麼酒最好喝嗎 天長地久 ",
      "length": 16,
      "addedAt": "2026-08-19T03:27:22.387Z"
    },
    {
      "id": 28,
      "content": "我才不和你說晚安，我要和你躺一張床上。 ",
      "length": 20,
      "addedAt": "2026-08-19T03:27:22.387Z"
    },
    {
      "id": 29,
      "content": "別說話用嘴感受 ",
      "length": 8,
      "addedAt": "2026-08-19T03:27:22.387Z"
    },
    {
      "id": 30,
      "content": "你是無可替代的 沒人和你醜的一模一樣 ",
      "length": 19,
      "addedAt": "2026-08-19T03:27:22.387Z"
    },
    {
      "id": 31,
      "content": "我是那種只在乎錢的人嗎？我在乎的是錢和你 ",
      "length": 21,
      "addedAt": "2026-08-19T03:27:22.387Z"
    },
    {
      "id": 32,
      "content": "在我的緊逼之下 他只好繳械投降",
      "length": 15,
      "addedAt": "2026-08-19T03:27:22.387Z"
    },
    {
      "id": 33,
      "content": "我這麼喜歡你，你喜歡我一下會死啊",
      "length": 16,
      "addedAt": "2026-08-19T03:27:22.387Z"
    },
    {
      "id": 34,
      "content": "你還小，我不忍心跟你談戀愛 ",
      "length": 14,
      "addedAt": "2026-08-19T03:27:22.387Z"
    },
    {
      "id": 35,
      "content": "說不出喜歡你什麼 就是想和你上床",
      "length": 16,
      "addedAt": "2026-08-19T03:27:22.387Z"
    },
    {
      "id": 36,
      "content": "躺好等艹了嗎?保證艹到你講方言。",
      "length": 16,
      "addedAt": "2026-08-19T03:27:22.387Z"
    },
    {
      "id": 37,
      "content": "相遇總有原因，不是恩賜，就是教訓 ",
      "length": 17,
      "addedAt": "2026-08-19T03:27:22.387Z"
    },
    {
      "id": 38,
      "content": "看不慣我你睡我啊 ",
      "length": 9,
      "addedAt": "2026-08-19T03:27:22.387Z"
    },
    {
      "id": 39,
      "content": "坐上來，自己動 ",
      "length": 8,
      "addedAt": "2026-08-19T03:27:22.387Z"
    },
    {
      "id": 40,
      "content": "不想周遊世界，只想在你心門口，喝茶聽雨。",
      "length": 20,
      "addedAt": "2026-08-19T03:27:22.387Z"
    },
    {
      "id": 41,
      "content": "我昨晚夢見你了 不知是你想我了還是我想你了 ",
      "length": 22,
      "addedAt": "2026-08-19T03:27:22.387Z"
    },
    {
      "id": 42,
      "content": "現在就我一人在家 ",
      "length": 9,
      "addedAt": "2026-08-19T03:27:22.387Z"
    },
    {
      "id": 43,
      "content": "別咬那麼緊 嗯啊",
      "length": 8,
      "addedAt": "2026-08-19T03:27:22.387Z"
    },
    {
      "id": 44,
      "content": "很晚才愛你，餘生只啪你。 ",
      "length": 13,
      "addedAt": "2026-08-19T03:27:22.387Z"
    },
    {
      "id": 45,
      "content": "請你當我手心裡的寶",
      "length": 9,
      "addedAt": "2026-08-19T03:27:22.387Z"
    },
    {
      "id": 46,
      "content": "為什麼哥哥會秒射，不會秒回？ ",
      "length": 15,
      "addedAt": "2026-08-19T03:27:22.387Z"
    },
    {
      "id": 47,
      "content": "不服約炮啊",
      "length": 5,
      "addedAt": "2026-08-19T03:27:22.387Z"
    },
    {
      "id": 48,
      "content": "少女怕日手遮陰 ",
      "length": 8,
      "addedAt": "2026-08-19T03:27:22.387Z"
    },
    {
      "id": 49,
      "content": "手段不夠硬，身段就要軟。 ",
      "length": 13,
      "addedAt": "2026-08-19T03:27:22.387Z"
    },
    {
      "id": 50,
      "content": "皂滑弄人 ",
      "length": 5,
      "addedAt": "2026-08-19T03:27:22.387Z"
    }
  ]
}